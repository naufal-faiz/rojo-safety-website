generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @db.Uuid
  email     String    @unique
  phone     String?
  username  String    @unique
  name      String
  role      UserRole  @default(USER)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("user")
}

model Seo {
  id              String    @id @default(uuid()) @db.Uuid
  metaTitle       String?   @map("meta_title")
  metaDescription String?   @map("meta_description")
  canonicalUrl    String?   @map("canonical_url")
  robotsIndex     Boolean   @default(true) @map("robots_index")
  robotsFollow    Boolean   @default(true) @map("robots_follow")
  ogTitle         String?   @map("og_title")
  ogDescription   String?   @map("og_description")
  ogImage         String?   @map("og_image")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  article         Article?
  training        Training?

  @@map("seo")
}

model ArticleCategory {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  articles  Article[]

  @@map("article_category")
}

model Article {
  id                String          @id @default(uuid()) @db.Uuid
  title             String
  slug              String          @unique
  content           String
  thumbnail         String          
  excerpt           String?
  views             Int             @default(0)
  status            PublishedStatus @default(DRAFT)
  articleCategoryId String          @map("article_category_id") @db.Uuid
  seoId             String?         @unique @map("seo_id") @db.Uuid
  publishedAt       DateTime?       @map("published_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  deletedAt         DateTime?       @map("deleted_at")
  adsModals         AdsModal[]
  category          ArticleCategory @relation(fields: [articleCategoryId], references: [id])
  seo               Seo?            @relation(fields: [seoId], references: [id])

  @@index([articleCategoryId])
  @@index([status])
  @@map("article")
}

model TrainingCategory {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  slug            String           @unique
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  heavyEquipments HeavyEquipment[]
  trainings       Training[]

  @@map("training_category")
}

model HeavyEquipment {
  id                 String           @id @default(uuid()) @db.Uuid
  name               String
  description        String
  image              String           
  trainingCategoryId String           @map("training_category_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  deletedAt          DateTime?        @map("deleted_at")
  category           TrainingCategory @relation(fields: [trainingCategoryId], references: [id])

  @@index([trainingCategoryId])
  @@map("heavy_equipment")
}

model Training {
  id                 String             @id @default(uuid()) @db.Uuid
  title              String
  slug               String             @unique
  description        String
  image              String             
  certification      CertificationType  @default(KEMNAKER)
  status             PublishedStatus    @default(DRAFT)
  trainingCategoryId String             @map("training_category_id") @db.Uuid
  seoId              String?            @unique @map("seo_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at")
  publishedAt        DateTime?          @map("published_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")
  seo                Seo?               @relation(fields: [seoId], references: [id])
  category           TrainingCategory   @relation(fields: [trainingCategoryId], references: [id])
  schedules          TrainingSchedule[]

  @@index([trainingCategoryId])
  @@index([status])
  @@map("training")
}

model TrainingSchedule {
  id         String                 @id @default(uuid()) @db.Uuid
  trainingId String                 @map("training_id") @db.Uuid
  type       TrainingScheduleType
  status     TrainingScheduleStatus @default(DRAFT)
  startAt    DateTime               @map("start_at")
  endAt      DateTime               @map("end_at")
  location   String?
  price      Decimal                @db.Decimal(12, 2)
  quota      Int
  batch      Int
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")
  deletedAt  DateTime?              @map("deleted_at")
  training   Training               @relation(fields: [trainingId], references: [id])
  registrations TrainingRegistration[]


  @@index([trainingId])
  @@index([status])
  @@index([type])
  @@map("training_schedule")
}

model TrainingRegistration {
  id                  String              @id @default(uuid()) @db.Uuid
  trainingScheduleId  String              @map("training_schedule_id") @db.Uuid
  schedule            TrainingSchedule    @relation(fields: [trainingScheduleId], references: [id])

  // Biodata peserta — calon field Person di V2
  name                String
  email               String
  phone               String?
  company             String?             // free text di V1, jadi FK Company di V2

  status              RegistrationStatus  @default(PENDING)
  reviewedAt          DateTime?           @map("reviewed_at")
  reviewedBy          String?             @map("reviewed_by") // id admin (User.id), string dulu
  rejectionReason     String?             @map("rejection_reason")
  notes               String?

  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  deletedAt           DateTime?           @map("deleted_at")

  @@unique([trainingScheduleId, email])
  @@index([trainingScheduleId, status])
  @@map("training_registration")
}

model AdsModal {
  id        String            @id @default(uuid()) @db.Uuid
  image     String
  placement AdsModalPlacement
  type      AdsModalType      @default(GENERAL)
  status    AdsModalStatus    @default(DRAFT)
  targetUrl String            @map("target_url")
  startAt   DateTime          @map("start_at")
  endAt     DateTime          @map("end_at")
  articleId String?           @map("article_id") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  deletedAt DateTime?         @map("deleted_at")
  article   Article?          @relation(fields: [articleId], references: [id])

  @@index([placement])
  @@index([articleId])
  @@map("ads_modal")
}

enum UserRole {
  ADMIN
  USER

  @@map("user_role")
}

enum PublishedStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("published_status")
}

enum TrainingScheduleType {
  PUBLIC
  INHOUSE

  @@map("training_schedule_type")
}

enum TrainingScheduleStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED

  @@map("training_schedule_status")
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("registration_status")
}

enum CertificationType {
  NONE
  BNSP
  KEMNAKER

  @@map("certification_type")
}

enum AdsModalPlacement {
  LANDING_PAGE
  ARTICLE

  @@map("ads_modal_placement")
}

enum AdsModalType {
  GENERAL
  ARTICLE_PROMOTION

  @@map("ads_modal_type")
}

enum AdsModalStatus {
  DRAFT
  ACTIVE
  INACTIVE

  @@map("ads_modal_status")
}
